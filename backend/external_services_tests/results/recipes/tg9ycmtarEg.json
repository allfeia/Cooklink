  "steps": [
    {
      "step_number": 1,
      "description": "Отжимаем творог, чтобы он был не сильно влажный."
    },
    {
      "step_number": 2,
      "description": "Добавляем 1/3 чайной ложки соли, одно яйцо, две столовые ложки сахара и одну пачку ванильного сахара. Если любите послаще, добавьте ещё пару столовых ложек сахара."
    },
    {
      "step_number": 3,
      "description": "Добавляем две столовые ложки картофельного крахмала (можно заменить на кукурузный) и полторы столовые ложки муки."
    },
    {
      "step_number": 4,
      "description": "Добавляем 1/3 чайной ложки разрыхлителя и всё хорошенько перемешиваем."
    },
    {
      "step_number": 5,
      "description": "Если масса получается жидкой, значит, недостаточно отжали творог. Влажными руками формируем колобочки весом примерно по 60 г."
    },
    {
      "step_number": 6,
      "description": "Обваливаем колобочки в кокосовой стружке."
    }
