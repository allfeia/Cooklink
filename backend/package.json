{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "test:1": "node external_services_tests/test-1-metadata.js",
    "test:1:A": "node external_services_tests/test-1-metadata.js --tool=A",
    "test:1:B": "node external_services_tests/test-1-metadata.js --tool=B",
    "test:1:C": "node external_services_tests/test-1-metadata.js --tool=C",
    "test:2": "node external_services_tests/test-2-subtitles.js",
    "test:2:A": "node external_services_tests/test-2-subtitles.js --tool=A",
    "test:2:B": "node external_services_tests/test-2-subtitles.js --tool=B",
    "test:2:10": "node external_services_tests/test-2-subtitles.js --limit=10",
    "test:3": "node external_services_tests/test-3-llm.js",
    "test:3:single": "node external_services_tests/test-3-llm.js --limit=1",
    "model-test": "node external_services_tests/utils/qwen-call.js",
    "fetch-recipe": "node external_services_tests/utils/fetch-recipe.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/backend/src/index.js",
    "start:metadata-worker": "node dist/backend/src/workers-http/metadataServer.js",
    "start:subtitles-worker": "node dist/backend/src/workers-http/subtitlesServer.js",
    "start:llm-worker": "node dist/backend/src/workers-http/llmServer.js",
    "start:pdf-worker": "node dist/backend/src/workers-http/pdfServer.js"
  },
  "dependencies": {
    "axios": "^1.15.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "openai": "^6.34.0",
    "pg": "^8.22.0",
    "undici": "^8.9.0",
    "yt-dlp-exec": "^1.0.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
