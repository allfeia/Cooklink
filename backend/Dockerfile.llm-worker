FROM node:20-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends python3 python-is-python3 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY common ./common
COPY backend/package.json backend/package-lock.json ./backend/
WORKDIR /app/backend
RUN npm ci
COPY backend ./
RUN npm run build

FROM node:20-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates python3 python-is-python3 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY common ./common
COPY backend/package.json backend/package-lock.json ./backend/
WORKDIR /app/backend
RUN npm ci --omit=dev
COPY --from=build /app/backend/dist ./dist

EXPOSE 4003
CMD ["node", "dist/backend/src/workers-http/llmServer.js"]
