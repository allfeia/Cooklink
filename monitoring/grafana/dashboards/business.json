{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["recipe", "business"],
  "time": { "from": "now-24h", "to": "now" },
  "timezone": "browser",
  "title": "Recipe Service — Бизнес Метрики",
  "uid": "recipe-business-v1",
  "version": 1,
  "panels": [
    {
      "type": "row",
      "title": "Сервис работает",
      "id": 1,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Успешность пайплайна (1ч)",
      "id": 2,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "green", "value": 90 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "clamp_max(sum(increase(recipe_jobs_completed_total{status=\"completed\"}[1h])) / clamp_min(sum(increase(recipe_jobs_created_total[1h])), 1) * 100, 100)",
          "legendFormat": "success rate",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Cache Hit Rate (24ч)",
      "id": 3,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 20 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(recipe_jobs_created_total{cache=\"hit\"}[24h])) / clamp_min(sum(increase(recipe_jobs_created_total[24h])), 1) * 100",
          "legendFormat": "cache hit",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Среднее время пайплайна (1ч)",
      "id": 4,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 90 },
              { "color": "red", "value": 180 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(recipe_pipeline_duration_seconds_sum{status=\"completed\"}[1h])) / clamp_min(sum(rate(recipe_pipeline_duration_seconds_count{status=\"completed\"}[1h])), 0.001)",
          "legendFormat": "avg",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "p95 время пайплайна (1ч)",
      "id": 5,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 120 },
              { "color": "red", "value": 300 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(recipe_pipeline_duration_seconds_bucket[1h])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Динамика запросов",
      "id": 6,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Запросы в час",
      "id": 7,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "sum(increase(recipe_jobs_created_total{cache=\"miss\"}[$__interval])) by (cache)",
          "legendFormat": "новые запросы",
          "refId": "A"
        },
        {
          "expr": "sum(increase(recipe_jobs_created_total{cache=\"hit\"}[$__interval])) by (cache)",
          "legendFormat": "из кэша",
          "refId": "B"
        },
        {
          "expr": "sum(increase(recipe_jobs_completed_total{status=\"completed\"}[$__interval]))",
          "legendFormat": "завершено",
          "refId": "C"
        },
        {
          "expr": "sum(increase(recipe_jobs_completed_total{status=\"failed\"}[$__interval]))",
          "legendFormat": "ошибки",
          "refId": "D"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Время пайплайна",
      "id": 8,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "sum(rate(recipe_pipeline_duration_seconds_sum{status=\"completed\"}[$__interval])) / clamp_min(sum(rate(recipe_pipeline_duration_seconds_count{status=\"completed\"}[$__interval])), 0.001)",
          "legendFormat": "среднее",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(recipe_pipeline_duration_seconds_bucket[$__interval])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(recipe_pipeline_duration_seconds_bucket[$__interval])) by (le))",
          "legendFormat": "медиана",
          "refId": "C"
        }
      ]
    },
    {
      "type": "row",
      "title": "Ошибки",
      "id": 9,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false
    },
    {
      "type": "bargauge",
      "title": "Ошибки по этапам (за период)",
      "description": "Сколько запросов упало на каждом этапе пайплайна за выбранный период (по порядку выполнения). Все четыре этапа показываются всегда, у этапов без ошибок будет 0.",
      "id": 10,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "top",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(recipe_pipeline_failures_total{stage=\"metadata\"}[$__range])) or vector(0)",
          "legendFormat": "1. Метаданные видео",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "sum(increase(recipe_pipeline_failures_total{stage=\"subtitles\"}[$__range])) or vector(0)",
          "legendFormat": "2. Субтитры",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "sum(increase(recipe_pipeline_failures_total{stage=\"llm\"}[$__range])) or vector(0)",
          "legendFormat": "3. Нейросеть (LLM)",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "sum(increase(recipe_pipeline_failures_total{stage=\"pdf\"}[$__range])) or vector(0)",
          "legendFormat": "4. Генерация PDF",
          "instant": true,
          "refId": "D"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Когда возникали ошибки (по часам)",
      "description": "Число ошибок по этапам за каждый час. Цвета этапов те же, что на панели слева.",
      "id": 17,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 85,
            "lineWidth": 0,
            "barAlignment": 0,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "1. Метаданные видео" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#378ADD" } } ] },
          { "matcher": { "id": "byName", "options": "2. Субтитры" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#1D9E75" } } ] },
          { "matcher": { "id": "byName", "options": "3. Нейросеть (LLM)" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#7F77DD" } } ] },
          { "matcher": { "id": "byName", "options": "4. Генерация PDF" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#D85A30" } } ] }
        ]
      },
      "targets": [
        {
          "expr": "sum(increase(recipe_pipeline_failures_total{stage=\"metadata\"}[1h])) or vector(0)",
          "legendFormat": "1. Метаданные видео",
          "interval": "1h",
          "refId": "A"
        },
        {
          "expr": "sum(increase(recipe_pipeline_failures_total{stage=\"subtitles\"}[1h])) or vector(0)",
          "legendFormat": "2. Субтитры",
          "interval": "1h",
          "refId": "B"
        },
        {
          "expr": "sum(increase(recipe_pipeline_failures_total{stage=\"llm\"}[1h])) or vector(0)",
          "legendFormat": "3. Нейросеть (LLM)",
          "interval": "1h",
          "refId": "C"
        },
        {
          "expr": "sum(increase(recipe_pipeline_failures_total{stage=\"pdf\"}[1h])) or vector(0)",
          "legendFormat": "4. Генерация PDF",
          "interval": "1h",
          "refId": "D"
        }
      ]
    },
    {
      "type": "stat",
      "title": "LLM Rate Limit (24ч)",
      "id": 11,
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(recipe_llm_rate_limit_total[24h]))",
          "legendFormat": "rate limits",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Отменено (24ч)",
      "id": 12,
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(recipe_jobs_completed_total{status=\"cancelled\"}[24h]))",
          "legendFormat": "cancelled",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Причины ошибок (из логов)",
      "description": "Сколько раз на каком этапе возникла какая ошибка за период. Данные из логов (Loki), доступны с момента, когда backend начал писать структурные логи.",
      "id": 18,
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 23 },
      "datasource": { "type": "loki", "uid": "${logs}" },
      "options": {
        "showHeader": true,
        "sortBy": [ { "displayName": "Количество", "desc": true } ]
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Этап" },
            "properties": [
              { "id": "mappings", "value": [ { "type": "value", "options": {
                "metadata": { "text": "1. Метаданные видео" },
                "subtitles": { "text": "2. Субтитры" },
                "llm": { "text": "3. Нейросеть (LLM)" },
                "pdf": { "text": "4. Генерация PDF" }
              } } ] }
            ]
          }
        ]
      },
      "transformations": [
        { "id": "labelsToFields", "options": { "mode": "columns" } },
        { "id": "merge", "options": {} },
        { "id": "organize", "options": {
          "excludeByName": { "Time": true },
          "renameByName": { "stage": "Этап", "error_code": "Код ошибки", "Value #A": "Количество" },
          "indexByName": { "stage": 0, "error_code": 1, "Value #A": 2 }
        } },
        { "id": "sortBy", "options": { "fields": {}, "sort": [ { "field": "Количество", "desc": true } ] } }
      ],
      "targets": [
        {
          "expr": "sum by (stage, error_code) (count_over_time({service=\"backend\"} | json | msg=\"stage failed\" [$__range]))",
          "queryType": "instant",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Использование",
      "id": 13,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Запросов за 24ч",
      "id": 14,
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(recipe_jobs_created_total[24h]))",
          "legendFormat": "запросы",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "PDF скачано за 24ч",
      "id": 15,
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(recipe_pdf_downloads_total[24h]))",
          "legendFormat": "downloads",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "PDF скачивания по времени",
      "id": 16,
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "hidden" }
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "sum(increase(recipe_pdf_downloads_total[$__interval]))",
          "legendFormat": "PDF",
          "refId": "A"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "label": "Datasource",
        "pluginId": "prometheus",
        "query": "prometheus",
        "refresh": 1,
        "current": {},
        "hide": 0
      },
      {
        "type": "datasource",
        "name": "logs",
        "label": "Logs",
        "pluginId": "loki",
        "query": "loki",
        "refresh": 1,
        "current": {},
        "hide": 0
      }
    ]
  }
}
